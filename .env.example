# PostgreSQL (matches docker-compose defaults)
DATABASE_URL="postgresql://oassistant:oassistant@localhost:5432/oassistant"

# LLM and TTS are configured in the app (Settings → Model / Voice), not here.

# Timeouts (ms). Increase for local models that need warm-up (Ollama).
MODEL_REQUEST_TIMEOUT_MS=120000
MODEL_HEALTH_TIMEOUT_MS=15000

# Single-user mode: stable id for your personal profile & memory
DEFAULT_USER_ID="me"

# Optional: protect OpenAI-compatible endpoints
API_SECRET=""
